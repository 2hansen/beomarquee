# Home Assistant connection for power-watch.ps1 (sleep -> standby, wake -> N.MUSIC).
# Copy this file to  ha.env  and fill in your own values. ha.env is gitignored: HA_TOKEN is a
# long-lived access token to your home automation, so it must never be committed.
#
# HA_TOKEN: Home Assistant -> your profile -> Security -> Long-lived access tokens -> Create.
# The Beosound must already be exposed to HA by the Masterlink Gateway (MLGW) integration --
# that integration is what actually speaks to the bus; this project just calls it.

HA_URL=http://192.168.1.10:8123
HA_TOKEN=paste-your-long-lived-access-token-here

# Optional -- only if your entity or source is named differently than the defaults.
#BS_ENTITY=media_player.beosound_9000
#BS_SOURCE=N.MUSIC
